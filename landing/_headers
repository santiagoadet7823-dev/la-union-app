# Cloudflare Pages: cabeceras de la landing (plan 11).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Las fuentes no cambian de nombre si cambian: se renuevan cada 30 días.
/fonts/*
  Cache-Control: public, max-age=2592000

# Capturas de la app (plan 14): si se reemplazan, cambiar el nombre del archivo.
/capturas/*
  Cache-Control: public, max-age=604800

# Fotos de rubros (plan 16): si se reemplazan, cambiar el nombre del archivo.
/fotos/*
  Cache-Control: public, max-age=604800

# Librerías y JS propio (plan 17): el número de versión va en el nombre; si cambian, cambiar el nombre.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=604800

# Pósters del mundo (plan 17): si se reemplazan, cambiar el nombre del archivo.
/mundo/*
  Cache-Control: public, max-age=604800
