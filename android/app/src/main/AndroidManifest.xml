<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.INTERNET" />
<!-- Re-armar el watchdog offline tras un reinicio del teléfono / actualización del APK (BootReceiver). -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.WAKE_LOCK" />
<!-- Permite pedir la exención de optimización de batería (Doze): en muchos OEMs el
     foreground service se mata igual al bloquear salvo que la app quede "sin restricciones". -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
<!-- Activity Recognition: saber si el vendedor está quieto / caminando / en vehículo sale
     ~gratis (lo resuelve el coprocesador de movimiento) y permite no tener el GPS a 1 Hz
     máxima precisión toda la jornada. Permiso de RUNTIME desde API 29. -->
<uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
<!-- Rama legacy para API 23-28, donde el permiso todavía lo definía Play Services y no
     el sistema. Se auto-concede en la instalación; queda capada en 28 para que en 29+
     mande la de arriba. -->
<uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"
    android:maxSdkVersion="28" />
<!-- Permite que la app lance el instalador del sistema con un .apk que ella misma descargó
     (updater de APK nativo, ver ApkUpdaterPlugin.java). Android igual exige que el usuario
     confirme "Instalar" y que "instalar apps desconocidas" esté habilitado para esta app. -->
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:name=".LaUnionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 🩸 CANAL POR DEFECTO DE FCM (04/08/2026). Sin este meta-data, una notificación que llega
             sin `channel_id` cae en el canal de reserva del SDK ("Miscellaneous"), que no es de
             importancia alta y que varios OEM silencian de fábrica: el servidor decía "enviado" y en
             el teléfono no aparecía nada. Apuntar acá es seguro porque el canal se crea en
             `LaUnionApp.onCreate()`, o sea antes de que pueda llegar un push. Ver LaUnionApp.java. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.launion.app" android:host="auth" />
            </intent-filter>

        </activity>

        <!-- Receptor de las transiciones de Activity Recognition. Declarado en el manifest
             (y no dinámico) para que las transiciones lleguen con la app en background e
             incluso con el proceso muerto: el PendingIntent es un broadcast explícito, así
             que puede arrancar el proceso en frío. exported="false" porque el intent lo
             dispara nuestra propia app. Ver MovimientoReceiver.java. -->
        <receiver
            android:name=".MovimientoReceiver"
            android:exported="false" />

        <!-- Receptor de la alarma del watchdog OFFLINE. Declarado en el manifest (no dinámico)
             por el mismo motivo que MovimientoReceiver: el PendingIntent de AlarmManager es un
             broadcast explícito que puede arrancar el proceso en frío. A diferencia del push,
             esta alarma dispara sin internet. exported="false": la dispara nuestra propia app.
             Ver AlarmReceiver.java / AlarmWatchdogPlugin.java. No requiere permiso nuevo:
             setAndAllowWhileIdle no exige SCHEDULE_EXACT_ALARM y WAKE_LOCK ya está declarado. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- FCM: quitamos el MessagingService de @capacitor/push-notifications del manifest merge y lo
             reemplazamos por el nuestro, que EXTIENDE de él y llama a super (conserva push en primer
             plano + captura de token) y suma el trabajo nativo del watchdog. Sin este remove, ambos
             servicios quedan declarados con el mismo intent-filter y FCM podría entregar dos veces.
             Ver LaUnionMessagingService.java. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".LaUnionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Re-arma el watchdog offline tras reinicio del teléfono / actualización del APK. exported=true:
             BOOT_COMPLETED es un broadcast del sistema. Solo re-programa la alarma (no abre Activity ni GPS,
             que Android 12+ bloquea desde background). Ver BootReceiver.java. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Uploader GPS nativo (Opción B): foreground service propio que captura y postea las
             posiciones sin depender del WebView (funciona con la pantalla bloqueada). foregroundServiceType
             location es obligatorio para acceder a GPS en 2º plano en Android 10+. Ver UploaderGpsService.java. -->
        <service
            android:name=".UploaderGpsService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
